# Drop-in site block for an EXISTING Caddy instance.
#
# Add one line to the running Caddy's Caddyfile:
#
#   import /opt/enip/Caddyfile.site
#
# No variables are required here. /admin is protected by the app itself, and the
# password hash is mounted from a file rather than passed through Compose -- an
# env var would be interpolated and any '$' in the hash silently dropped.
#
# BEFORE reloading: delete any existing site block for enip-human.duckdns.org in
# that Caddyfile. Two blocks for the same host is a fatal "ambiguous site
# definition" error. The current setup already has an HTTP->HTTPS redirect for
# this host and no certificate for it, which is why :443 fails TLS handshake.
#
# Reaches the app by container name, so the app's compose file and this Caddy
# container must share the external `caddy-proxy` network:
#   docker network create caddy-proxy
#   docker network connect caddy-proxy <existing-caddy-container>

{$SITE_ADDRESS:enip-human.duckdns.org} {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	request_body {
		max_size 10MB
	}

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# Liveness endpoint served by Caddy itself (no upstream dependency).
	@healthz path /healthz
	respond @healthz "ok" 200

	# /admin needs no proxy-side protection: app.py gates it with a real login
	# (templates/admin_login.html) and the password hash is mounted from a file,
	# never passed through Compose, so no secret can be mangled here.

	reverse_proxy webapp:8080
}
