# Copy to .env and edit. Never commit .env (already gitignored).

# Public hostname for the evaluation site. The A record already resolves to the
# server's static public IP 103.93.161.153, and both :80 and :443 are reachable
# from the internet, so Let's Encrypt HTTP-01 issuance should succeed.
SITE_ADDRESS=enip-human.duckdns.org

# Contact address for ACME expiry notices.
ACME_EMAIL=bagas_wap@outlook.com

# Signs Flask session cookies. Generate a fresh random value:
#   openssl rand -hex 32
# Rotating this invalidates all existing evaluator sessions.
SECRET_KEY=

# Credentials for /admin, which the Flask app leaves unauthenticated. The Caddy
# container needs this in ITS environment too, not just the app's. Store the
# bcrypt hash, never the plaintext. Generate with:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
ADMIN_USER=admin

# IMPORTANT: wrap the hash in single quotes. Compose interpolates `$`, and a bare
# bcrypt hash is silently TRUNCATED -- `$2a$14$abc` resolves to just `$2a$14`,
# because `$abc` is read as a (undefined) variable name. That fails as a confusing
# Caddy "invalid hash" error, not an obvious secret bug.
ADMIN_PASSWORD_HASH=

# Verify it survived, char for char, BEFORE restarting Caddy:
#   docker compose config | grep ADMIN_PASSWORD_HASH
# If it is mangled, move only this variable to an `env_file:` entry, which
# Compose passes through with no interpolation at all.
